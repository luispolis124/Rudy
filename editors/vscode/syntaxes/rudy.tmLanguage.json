{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Rudy",
  "scopeName": "source.rudy",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#functions"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [{
        "name": "comment.line.double-slash.rudy",
        "match": "//.*$"
      }]
    },
    "keywords": {
      "patterns": [{
        "name": "keyword.control.rudy",
        "match": "\\b(action|acao|if|se|else|senao|while|enquanto|then|entao|var|use|usar)\\b"
      }]
    },
    "functions": {
      "patterns": [{
        "name": "support.function.rudy",
        "match": "\\b(write|escrever|ask|ler|random|aleatorio|sleep|pausar|save|salvar|load|carregar|clear|limpar)\\b"
      }]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.rudy",
          "begin": "\"",
          "end": "\""
        },
        {
          "name": "string.quoted.single.rudy",
          "begin": "'",
          "end": "'"
        }
      ]
    },
    "numbers": {
      "patterns": [{
        "name": "constant.numeric.rudy",
        "match": "\\b\\d+\\b"
      }]
    }
  }
}
